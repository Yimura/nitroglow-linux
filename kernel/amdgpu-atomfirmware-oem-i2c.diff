 {
-	if (!adev->is_atom_fw) {
+	if (adev->is_atom_fw) {
+		/*
+		 * atomfirmware (Vega and later) has no GPIO_I2C_Info table.
+		 * The board specific i2c line, if any, is named by
+		 * firmwareinfo.board_i2c_feature_gpio_id and resolved through
+		 * the gpio_pin_lut table.
+		 */
+		amdgpu_atomfirmware_oem_i2c_init(adev);
+	} else {
 		if (!amdgpu_device_has_dc_support(adev)) {
 			amdgpu_atombios_i2c_init(adev);
 		} else {
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
@@ -4001,9 +4001,10 @@ int amdgpu_device_init(struct amdgpu_device *adev)
 				amdgpu_vf_error_put(adev, AMDGIM_ERROR_VF_ATOMBIOS_GET_CLOCK_FAIL, 0, 0);
 				goto failed;
 			}
-			/* init i2c buses */
-			amdgpu_i2c_init(adev);
 		}
+
+		/* init i2c buses */
+		amdgpu_i2c_init(adev);
 	}
 
 fence_driver_init:

--------------------------------------------------------------------------------
NOTES FOR WHOEVER BUILDS THIS
--------------------------------------------------------------------------------

* This is a hand-written diff against the v7.1.5 sources in ref/linux-7.1.5/,
  not the output of `git diff`. The hunk headers were recomputed from the hunk
  bodies so the line counts are self-consistent, and every hunk start line was
  checked against the real files, but blank context lines were normalised. Apply
  with `patch -p1 -l --fuzz=3`, or just reproduce the four edits by hand -- they
  are small and self-contained.

* adev->i2c_bus[0] is used as the storage slot. AMDGPU_MAX_I2C_BUS is 16
  (amdgpu_mode.h:127) and nothing else populates the array on an atomfirmware
  ASIC, so slot 0 is free. Note amdgpu_i2c_fini() only NULLs the array; the
  adapter itself is released by devm_/i2c_bit_add_bus() teardown, same as the
  existing Polaris path -- i.e. this patch inherits whatever lifetime handling
  the existing code has, it does not make it worse.

* IMPORTANT, if the new bus appears but still NAKs. A read-only register dump on
  the test machine (vbios/i2c-lines.md section 8.1) shows
  DC_GPIO_DDCVGA_MASK = 0xcf401000, i.e. DC_GPIO_DDCVGADATA_PD_EN (bit 12, the
  internal pull-down on SDA) is ASSERTED, while bit 4 is clear. That asymmetry is
  the signature of the GPIO_DDC_LINE_DDC_VGA special case at hw_ddc.c:97-99, and
  the guard around it (hw_ddc.c:96) can never evaluate false on this line because
  DDC_MASK_SH_LIST_COMMON (ddc_regs.h:96-102) makes it read bit 4 of
  DC_GPIO_DDCVGA_MASK, a bit that register does not define
  (grep -c 'DC_GPIO_DDCVGA_MASK__DC_GPIO_DDCVGACLK_PD_EN' -> 0). Nothing in
  hw_ddc.c ever clears it.

  amdgpu_i2c_pre_xfer() (amdgpu_i2c.c:39-79) claims the pads but does NOT clear
  that bit, so this new bus drives the same pads with the pull-down still on.
  Deliberately NOT changed here, because (a) pre_xfer is shared by every legacy
  ASIC and (b) these pull-downs are usually weak enough that a board pull-up
  wins, so it may well be a red herring. If the bus NAKs, the one-line
  experiment is to clear bit 12 of rec->mask_data_reg in pre_xfer for this rec
  and retry. Do that before concluding the pads are unconnected.

* If you want to probe the two i2c lines this card leaves completely unbound --
  gpio_id 0x92 (DC_GPIO_DDC3, a_reg 0x5D99) and 0x94 (DC_GPIO_DDC5,
  a_reg 0x5DA1) -- the cheapest experiment is to loop over every gpio_pin_lut
  entry with (gpio_id & 0x80) instead of matching only oem_id, and register each
  one that no dc link claims. That is deliberately NOT in this patch: it would
  add adapters on pads that dc also drives for DDC, and the two lines are not
  named by anything in the VBIOS.

* Verification steps are in vbios/i2c-lines.md section 9. In short: expect a new
  adapter named exactly "AMDGPU i2c bit bus OEM 0x97" plus a dev_info line, then
  a single-address read `i2cget -y <newbus> 0x28`. Do not run i2cdetect sweeps.
